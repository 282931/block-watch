generator client {
  provider = "prisma-client"
  output   = "../generated/prisma"
}

datasource db {
  provider = "postgresql"
}

model customers {
  id        String @id @default(dbgenerated("uuid_generate_v4()")) @db.Uuid
  name      String @db.VarChar(255)
  email     String @db.VarChar(255)
  image_url String @db.VarChar(255)
}

model invoices {
  id          String   @id @default(dbgenerated("uuid_generate_v4()")) @db.Uuid
  customer_id String   @db.Uuid
  amount      Int
  status      String   @db.VarChar(255)
  date        DateTime @db.Date
}

model revenue {
  month   String @unique @db.VarChar(4)
  revenue Int
}

model users {
  id       String @id @default(dbgenerated("uuid_generate_v4()")) @db.Uuid
  name     String @db.VarChar(255)
  email    String @unique
  password String
}

model User {
  id        String   @id @default(uuid()) @db.Uuid
  name      String   @db.VarChar(255)
  email     String   @unique
  password  String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  wallets WalletAddress[]
}

model WalletAddress {
  id        String   @id @default(uuid()) @db.Uuid
  userId    String   @db.Uuid
  address   String   @db.VarChar(255)
  chain     String   @default("ethereum")
  label     String?
  createdAt DateTime @default(now())
  balanceEth        String?  @db.VarChar(78)
  balanceWei        String?  @db.VarChar(78)
  balanceUpdatedAt  DateTime?
  // Tracks the most recent time anyone read this wallet's balance via the
  // service. The scheduler uses this to skip cold addresses that nobody is
  // looking at, keeping the periodic fan-out small.
  lastAccessedAt    DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, address])
  @@index([chain, lastAccessedAt])
}
